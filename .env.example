# SUPABASE PUBLIC CREDENTIALS (Client-Side & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE RESTRICTED SECRETS (Server-Side Only - NUNCA expor no client-side)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# DATABASE CONNECTION (Migrations & Poolers)
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:password@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# KEEPALIVE & BACKUP SYSTEM SECRET
SYSTEM_BACKUP_SECRET="generate-a-strong-random-secret"
